{
  "format": "pixelfx",
  "kind": "preset",
  "version": 2,
  "name": "Stage lighting",
  "group": "Profiles",
  "workingSpace": "rec2020-linear",
  "body": {
    "settings": {
      "bw": {
        "enabled": false
      },
      "color": {
        "saturation": 8.0,
        "vibrance": 5.0
      },
      "detail": {
        "clarity": 25.0,
        "dehaze": 15.0
      },
      "grading": {
        "balance": 0.0,
        "blending": 75.0,
        "global": {
          "amount": 0.0,
          "hue": 0.0,
          "luminance": 0.0
        },
        "highlights": {
          "amount": 12.0,
          "hue": 42.0,
          "luminance": 0.0
        },
        "midtones": {
          "amount": 0.0,
          "hue": 0.0,
          "luminance": 0.0
        },
        "shadows": {
          "amount": 15.0,
          "hue": 225.0,
          "luminance": 0.0
        }
      },
      "light": {
        "blacks": -15.0,
        "contrast": 30.0,
        "exposure": 0.25,
        "highlights": -50.0,
        "shadows": 15.0,
        "whites": 10.0
      },
      "mixer": {
        "saturation": {
          "blue": 10.0,
          "green": -20.0,
          "magenta": 10.0
        }
      }
    }
  }
}
