        "denoise": {
          "luminance": 20.0
        }
      },
      "grading": {
        "balance": 0.0,
        "blending": 75.0,
        "global": {
          "amount": 0.0,
          "hue": 0.0,
          "luminance": 0.0
        },
        "highlights": {
          "amount": 8.0,
          "hue": 40.0,
          "luminance": 0.0
        },
        "midtones": {
          "amount": 0.0,
          "hue": 0.0,
          "luminance": 0.0
        },
        "shadows": {
          "amount": 10.0,
          "hue": 235.0,
          "luminance": 0.0
        }
      },
      "light": {
        "blacks": -10.0,
        "contrast": 20.0,
        "exposure": 0.5,
        "highlights": -40.0,
        "shadows": 30.0,
        "whites": 5.0
      },
      "mixer": {
        "luminance": {
          "orange": 5.0
        },
        "saturation": {
