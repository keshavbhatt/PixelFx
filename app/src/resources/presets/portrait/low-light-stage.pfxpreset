{
  "format": "pixelfx",
  "kind": "preset",
  "version": 2,
  "name": "Low light stage",
  "group": "Profiles",
  "workingSpace": "rec2020-linear",
  "body": {
    "settings": {
      "bw": {
        "enabled": false
      },
      "color": {
        "saturation": -5.0,
        "vibrance": -3.0
      },
      "detail": {
