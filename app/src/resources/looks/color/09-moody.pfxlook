      },
      {
        "op": "mixer",
        "v": 1,
        "enabled": true,
        "params": {
          "luminance": {
            "green": -15.0
          },
          "saturation": {
            "blue": -20.0,
            "green": -40.0
          }
        }
      },
      {
        "op": "vibrance_saturation",
        "v": 1,
        "enabled": true,
        "params": {
          "saturation": -25.0
        }
      },
      {
        "op": "grading",
        "v": 1,
        "enabled": true,
        "params": {
          "shadows": {
            "amount": 20.0,
            "hue": 210.0
          }
        }
      },
      {
        "op": "vignette",
        "v": 1,
        "enabled": true,
        "params": {
